# Local-only Compose configuration used directly with --env-file.
DEVRADAR_APP_IMAGE=devradar-app:local
DEVRADAR_CRAWLER_IMAGE=devradar-crawler:local
DEVRADAR_WEB_IMAGE=devradar-web:local
DEVRADAR_API_HOST_PORT=8000
DEVRADAR_WEB_HOST_PORT=3000
DEVRADAR_DB_HOST_PORT=55432
DEVRADAR_OPERATOR_WRITE_ENABLED=false
DEVRADAR_CV_LOCAL_ENABLED=false
DEVRADAR_ALERTS_LOCAL_ENABLED=false
DEVRADAR_CUSTOM_SOURCES_LOCAL_ENABLED=false
DEVRADAR_CUSTOM_SOURCE_POLL_SECONDS=10
DEVRADAR_AUTH_ENABLED=false
DEVRADAR_OPERATOR_USERNAME=operator
DEVRADAR_OPERATOR_PASSWORD_HASH=
DEVRADAR_AUTH_SESSION_TTL_SECONDS=86400
DEVRADAR_AUTH_COOKIE_SECURE=false
DEVRADAR_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DEVRADAR_DEPLOYMENT_CLASS=LOCALHOST_SERVICE
DEVRADAR_SECRET_SOURCE=environment
DEVRADAR_RATE_LIMIT_ENABLED=true
DEVRADAR_RATE_LIMIT_GENERAL_MAX=120
DEVRADAR_RATE_LIMIT_GENERAL_WINDOW_SECONDS=60
DEVRADAR_RATE_LIMIT_AUTH_MAX=10
DEVRADAR_RATE_LIMIT_AUTH_WINDOW_SECONDS=900
DEVRADAR_RATE_LIMIT_DISPATCH_MAX=5
DEVRADAR_RATE_LIMIT_DISPATCH_WINDOW_SECONDS=60
DEVRADAR_RATE_LIMIT_MAX_KEYS=10000
# Optional V5 local/protected alert connector; never commit a real webhook URL.
DEVRADAR_DISCORD_WEBHOOK_URL=

# Optional V3 live spike: synthetic evaluation cases only; never put a real key here.
# Put only the rotated key in ignored .env.local or load it into the current process.
DEVRADAR_DEEPSEEK_API_KEY=
POSTGRES_DB=devradar
POSTGRES_USER=devradar
POSTGRES_PASSWORD=devradar_local_only
